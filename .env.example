# Optional overrides; the CLI reads the environment, not this file automatically.
# Production defaults to the platform's user data directory, outside the checkout.
# RUMINATE_DATA_DIR=/absolute/path/to/private/data
RUMINATE_NETWORK_MODE=ask
# Explicit file/directory grants for the Python API and retries without a saved snapshot.
# Leave empty to grant no implicit file access; CLI ingest authorizes its selected file only.
# RUMINATE_ALLOWED_ROOTS=/absolute/path/to/authorized/documents
# Exact hosts only, used when RUMINATE_NETWORK_MODE=allowlist.
# RUMINATE_ALLOWED_HOSTS=example.org,www.example.org
# RUMINATE_MAX_SOURCE_BYTES=20971520
# RUMINATE_MAX_PDF_PAGES=500
# RUMINATE_PARSE_TIMEOUT=10
# RUMINATE_FETCH_TIMEOUT=10
# Calendar-day quota for review presentation (IANA timezone).
# RUMINATE_REVIEW_TIMEZONE=Asia/Shanghai
# Enable MCP workflow writes; the plain MCP command stays read-only by default.
# RUMINATE_MCP_WRITES=1
